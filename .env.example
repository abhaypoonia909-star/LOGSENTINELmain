# LogSentinel environment variables
#
# Local setup
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# Put the file at the project root and/or at backend/.env.
#
# Actual load order in backend/config.py (do not invert this):
#   1. project-root .env  (fills missing names; does not override the process)
#   2. backend/.env with override=True  (backend/.env wins over root .env)
#   3. Empty JWT_SECRET, DATABASE_URL, OLLAMA_BASE_URL, OLLAMA_MODEL,
#      OPENAI_API_KEY, and OPENAI_MODEL values are then popped so code defaults apply
#
# Hosted Flask (Render: one web service + Postgres)
#   Set the same names in the host's environment variable settings.
#   Do not put API keys on the frontend host or in HTML/JavaScript.
#   On Render set LOGSENTINEL_ENV=production and paste the Postgres DATABASE_URL.
#   Leave DATABASE_URL empty on your laptop so SQLite (backend/logsentinel.db) is used.
#
# Values below match the code defaults used when a variable is unset.
# Never commit a real .env file.

SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET=
JWT_EXPIRY_HOURS=24
# Leave empty on a laptop. Set to production on Render.
LOGSENTINEL_ENV=

# Local SentinelAI (default). Install Ollama and pull the small model once.
# After that, chat works offline. No API key is required.
# Source of truth when unset: backend/utils/ollama_settings.py (used by AIService).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=80
OLLAMA_NUM_PREDICT_SHORT=48
OLLAMA_NUM_PREDICT_ANALYSIS=120
OLLAMA_NUM_PREDICT_LONG=512
OLLAMA_KEEP_ALIVE=60m
OLLAMA_HISTORY_TURNS=6

# Optional paid path only. Not used unless AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

ADMIN_EMAILS=
DATABASE_URL=
RATE_LIMIT=60/minute
AUTH_RATE_LIMIT=10/minute

# Uploaded-log Brute Force (LogAnalyzer). Historical default is 2 failed
# logins per IP. This is not the Live Alerts detector.
BRUTE_FORCE_THRESHOLD=2

# Live security alerts (demo-login only for mitigation)
ALERT_FAILED_LOGIN_THRESHOLD=5
ALERT_FAILED_LOGIN_WINDOW_SECONDS=300
ALERT_DEMO_MITIGATION=1
ALERT_DEMO_BLOCK_SECONDS=120
ALERT_POLL_SECONDS=5
DEMO_LOGIN_RATE_LIMIT=30/minute
DEMO_LOGIN_USERNAME=demo
DEMO_LOGIN_PASSWORD=Demo1234

# Attack correlation window for findings with the same known source IP
INCIDENT_CORRELATION_WINDOW_SECONDS=900
